{
  "name": "@pangaea/glob-audit-tool",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Docusign, Inc.",
  "repository": "https://github.com/docusign/pangaea.git",
  "resolutions": {
    "npm-check-updates": "19.3.1"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "check-types": "turbo run check-types",
    "sbom": "yarn cyclonedx --output-reproducible --output-file sbom.json",
    "clean": "turbo run clean && rimraf node_modules .turbo",
    "changeset": "changeset",
    "changeset:status": "changeset status --output json",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "prepare": "husky",
    "ado:lint": "yarn format:check && yarn lint",
    "ado:build": "if [ \"$BUILD_REASON\" = \"PullRequest\" ]; then echo 'PR build: building only affected packages' && yarn build:affected; else echo 'Full build: building all packages' && yarn build; fi",
    "ado:test": "if [ \"$BUILD_REASON\" = \"PullRequest\" ]; then echo 'PR test: testing only affected packages' && yarn test:affected; else echo 'Full test: testing all packages' && yarn test:coverage; fi && yarn coverage:merge",
    "coverage:merge": "node scripts/merge-coverage.mjs",
    "coverage:report": "yarn test:coverage && yarn coverage:merge",
    "workspace:list": "yarn workspaces list",
    "workspace:info": "yarn workspaces info",
    "build:affected": "turbo run build --affected",
    "test:affected": "turbo run test:coverage --affected",
    "lint:affected": "turbo run lint --affected",
    "check-types:affected": "turbo run check-types --affected",
    "lint:fix": "turbo run lint:fix",
    "format:affected": "turbo run format --affected"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.1",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/eslint-plugin": "^1.6.24",
    "@vitest/ui": "^3.2.7",
    "esbuild": "^0.25.8",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "happy-dom": "^20.0.10",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "monocart-coverage-reports": "^2.12.6",
    "prettier": "^3.4.1",
    "rimraf": "^6.1.0",
    "tsup": "^8.5.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@4.9.2",
  "workspaces": [
    "packages/*"
  ]
}
