{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": ["chrome"],
    "target": "ESNext",
    "module": "ESNext",
    "jsx": "react-jsx",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
