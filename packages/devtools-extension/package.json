{
  "name": "@pangaea-g11n/extension",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome Extension for the Globalization Audit Tool",
  "license": "MIT",
  "author": "Docusign, Inc.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prebuild": "yarn clean",
    "dev": "webpack serve --mode development",
    "build": "webpack --mode production",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "check-types": "tsc --build",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist coverage .turbo .tsbuildinfo"
  },
  "dependencies": {
    "@pangaea-g11n/core": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.7",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/uuid": "^11.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "html-webpack-plugin": "^5",
    "ts-loader": "^9",
    "typescript": "^5.7.2",
    "webpack": "^5",
    "webpack-cli": "^7"
  },
  "module": "./dist/index.js"
}
