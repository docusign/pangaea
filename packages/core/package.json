{
  "name": "@pangaea/core",
  "version": "0.1.0",
  "description": "Core library for the Globalization Audit Tool",
  "keywords": [
    "globalization",
    "internationalization",
    "i18n",
    "l10n",
    "localization",
    "rtl",
    "encoding",
    "audit"
  ],
  "license": "MIT",
  "author": "Docusign, Inc.",
  "homepage": "https://github.com/docusign/pangaea/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/docusign/pangaea.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/docusign/pangaea/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prebuild": "yarn clean",
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "check-types": "tsc --build",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist coverage .turbo .tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/uuid": "^11.0.0",
    "typescript": "^5.7.2"
  },
  "module": "./dist/index.js",
  "dependencies": {
    "@medv/finder": "^4.0.2",
    "franc-min": "6.2.0",
    "uuid": "^13.0.0"
  }
}
