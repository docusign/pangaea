{
  "name": "@pangaea-g11n/playwright",
  "version": "0.4.1",
  "description": "Playwright plugin for the Globalization Audit Tool",
  "keywords": [
    "globalization",
    "internationalization",
    "i18n",
    "l10n",
    "localization",
    "playwright",
    "e2e",
    "audit"
  ],
  "license": "MIT",
  "author": "Docusign, Inc.",
  "homepage": "https://github.com/docusign/pangaea/tree/main/packages/playwright-plugin#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/docusign/pangaea.git",
    "directory": "packages/playwright-plugin"
  },
  "bugs": {
    "url": "https://github.com/docusign/pangaea/issues"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./pangea-reporter": {
      "types": "./dist/pangeaReporter.d.ts",
      "import": "./dist/pangeaReporter.js",
      "require": "./dist/pangeaReporter.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prebuild": "yarn clean",
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "check-types": "tsc --build",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist coverage .turbo .tsbuildinfo"
  },
  "peerDependencies": {
    "@playwright/test": "^1.40.0"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@pangaea-g11n/core": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2"
  }
}
